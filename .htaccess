RewriteEngine On

# Permitir acesso a arquivos com extensões específicas (.png, .jpg, .jpeg)
RewriteCond %{REQUEST_URI} \.(png|jpg|jpeg)$ [NC]
RewriteRule ^ - [L]

# Certifica-se de que arquivos e diretórios reais NÃO sejam redirecionados
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redireciona todas as outras requisições (que não correspondem a arquivos ou diretórios reais) para 'index.php'
RewriteRule ^ index.php [L]
